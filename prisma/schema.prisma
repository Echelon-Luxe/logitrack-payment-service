generator client {
  provider = "prisma-client-js"
  // Pinned, not detected. The build stage (node:24-bookworm-slim) has no
  // openssl CLI, so Prisma cannot detect the platform and falls back to
  // debian-openssl-1.1.x - while the distroless runtime needs 3.0.x, and
  // the engine it looks for is simply absent from the image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  ABANDONED
}

model Payment {
  id          String        @id @default(uuid())

  // Our reference, sent to Paystack and echoed back on the webhook.
  reference   String        @unique

  shipmentId  String
  customerId  String
  email       String

  // Kobo/cents. Never a float - 0.1 + 0.2 != 0.3 and money must be exact.
  amount      Int
  currency    String        @default("NGN")

  status      PaymentStatus @default(PENDING)
  paystackId  String?
  channel     String?
  paidAt      DateTime?
  failureText String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shipmentId])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

// Paystack retries webhooks; the event id makes replay a no-op.
model ProcessedWebhook {
  id        String   @id
  event     String
  reference String
  createdAt DateTime @default(now())
}

model OutboxEvent {
  id           String    @id @default(uuid())
  partitionKey String
  eventType    String
  envelope     Json
  publishedAt  DateTime?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())

  @@index([publishedAt, createdAt])
}
